<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Hangar</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8305;WMC1501</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Inspection\borescope.png" />
    <EmbeddedResource Include="Assets\Globe\land-dots.bin" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.4-experimental" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
  </ItemGroup>

  <!--
    WinAppSDK 2.5.4-experimental: XamlChartsResources / TabularControlsResources resolve their
    theme dictionaries via ms-appx:///, but the framework package keeps them in separate .pri files
    that are not merged into a framework-dependent app's resources.pri. Merge them explicitly.
  -->
  <PropertyGroup>
    <_HangarWinUIPriDir>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))microsoft.windowsappsdk.winui\2.3.10-experimental\runtimes-framework\$(RuntimeIdentifier)\native\</_HangarWinUIPriDir>
  </PropertyGroup>
  <ItemGroup>
    <_HangarExtraPri Include="$(_HangarWinUIPriDir)Microsoft.UI.Xaml.Controls.Charts.pri;$(_HangarWinUIPriDir)Microsoft.UI.Xaml.Controls.Tabular.pri" />
  </ItemGroup>
  <Target Name="HangarMergeExperimentalControlPri" AfterTargets="_ComputeInputPriFiles">
    <ItemGroup>
      <_PriFile Include="@(_HangarExtraPri)" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
  </Target>

  <!--
    Aion Instruct (preview), aka.ms/tryaion. Auto-enabled only when the SDK nupkg sits in the
    git-ignored <repo>/nuget-local/ feed; force with -p:EnableAion=true|false. When enabled the
    app takes a package dependency on the Aion framework + Windows App Runtime 2, so it is opt-in:
    machines without the feed build and launch the plain (Phi Silica / scripted) app.
  -->
  <PropertyGroup>
    <HangarAionFeed>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\nuget-local'))</HangarAionFeed>
    <HangarAionPackageVersion>1.0.1</HangarAionPackageVersion>
    <EnableAion Condition="'$(EnableAion)' == '' and Exists('$(HangarAionFeed)AionInstructPreview.Text.Framework.$(HangarAionPackageVersion).nupkg')">true</EnableAion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableAion)' == 'true'">
    <DefineConstants>$(DefineConstants);HANGAR_AION</DefineConstants>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(HangarAionFeed)</RestoreAdditionalProjectSources>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableAion)' == 'true'">
    <PackageReference Include="AionInstructPreview.Text.Framework" Version="[$(HangarAionPackageVersion)]" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.5" />
  </ItemGroup>
  <!--
    The Aion targets inject their PackageDependency entries by rewriting @(AppxManifest) in place.
    Point them at an intermediate copy so the committed Package.appxmanifest stays clean, and run
    the injection up front (PrepareForBuild) so the very first build already carries the deps.
  -->
  <Target Name="HangarAionRedirectManifest"
          BeforeTargets="PrepareForBuild;AionInstructPreviewText_InjectPackageDependency;_GenerateAppxManifest;GenerateAppxManifest"
          Condition="'$(EnableAion)' == 'true' and '@(AppxManifest)' != '' and '$(_HangarAionManifestRedirected)' != 'true'">
    <PropertyGroup>
      <_HangarAionManifest>$(ProjectDir)$(IntermediateOutputPath)aion\Package.appxmanifest</_HangarAionManifest>
      <_HangarAionManifestRedirected>true</_HangarAionManifestRedirected>
    </PropertyGroup>
    <Copy SourceFiles="@(AppxManifest)" DestinationFiles="$(_HangarAionManifest)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_HangarAionManifest)" />
    </ItemGroup>
    <Message Importance="high" Text="[Hangar] Aion Instruct (preview) enabled; manifest dependencies injected into $(_HangarAionManifest)" />
  </Target>
  <Target Name="HangarAionInjectEarly"
          AfterTargets="HangarAionRedirectManifest"
          DependsOnTargets="AionInstructPreviewText_InjectPackageDependency"
          Condition="'$(EnableAion)' == 'true'" />

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(PublishAot)' == 'true'">True</PublishTrimmed>
  </PropertyGroup>

  <!-- Runtime perf knobs (apply to all publish flavors). -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- Native AOT: dotnet publish -c Release -p:Platform=ARM64 -p:PublishAot=true -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishReadyToRun>false</PublishReadyToRun>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>
</Project>

