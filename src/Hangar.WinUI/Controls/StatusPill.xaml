<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Hangar.Controls.StatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <Border
        x:Name="Pill"
        Background="{ThemeResource NeutralSoftBrush}"
        BorderBrush="{ThemeResource NeutralStatusBrush}"
        Style="{StaticResource PillBorderStyle}">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse
                x:Name="Dot"
                Width="6"
                Height="6"
                VerticalAlignment="Center"
                Fill="{ThemeResource NeutralStatusBrush}" />
            <TextBlock
                x:Name="Label"
                Foreground="{ThemeResource NeutralStatusBrush}"
                Style="{StaticResource PillTextStyle}"
                Text="Open" />
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StatusStates">
                <VisualState x:Name="Open">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource AccentCyanSoftBrush}" />
                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource AccentCyanBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource AccentCyanBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource AccentCyanBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InProgress">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource AttentionSoftBrush}" />
                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource AttentionBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource AttentionBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource AttentionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Deferred">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource CriticalSoftBrush}" />
                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource CriticalBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource CriticalBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource CriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Closed">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource HealthySoftBrush}" />
                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource HealthyBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource HealthyBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource HealthyBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Border>
</UserControl>
