<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Hangar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hangar.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Hangar.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Hangar.ViewModels"
    Title="HANGAR · Contoso Aero"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource CanvasTintBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Invoked="OnDemoResetInvoked"
                Key="D"
                Modifiers="Control,Shift" />
            <KeyboardAccelerator
                Invoked="OnToggleThemeInvoked"
                Key="L"
                Modifiers="Control,Shift" />
            <KeyboardAccelerator
                Invoked="OnFocusSearchInvoked"
                Key="K"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnAskToggleInvoked"
                Key="Space"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnAskForceScriptedInvoked"
                Key="A"
                Modifiers="Control,Shift" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.ColumnSpan="2"
            Height="56"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            Subtitle="Contoso Aero · Night shift"
            Title="HANGAR">
            <TitleBar.IconSource>
                <FontIconSource FontSize="18" Foreground="{ThemeResource AccentCyanBrush}" Glyph="&#xE709;" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="320"
                    MaxWidth="520"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="GlobalSearchBox"
                    AutomationProperties.Name="Search tail, part, or work order"
                    ItemsSource="{x:Bind ViewModel.Suggestions}"
                    PlaceholderText="Search tail, part, or work order"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchQuerySubmitted"
                    TextChanged="OnSearchTextChanged"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchSuggestion">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentCyanBrush}"
                                    Glyph="{x:Bind Glyph, Mode=OneTime}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource MonoTextStyle}" Text="{x:Bind Title, Mode=OneTime}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        Text="{x:Bind Detail, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="AskHangarButton"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AskHangarButton"
                        AutomationProperties.Name="Ask Hangar"
                        Click="OnAskButtonClick"
                        CornerRadius="16"
                        ToolTipService.ToolTip="Ask Hangar (Ctrl+Space)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource AccentCyanBrush}"
                                Text="&#x2726;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="Ask Hangar" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="13"
                        Foreground="{ThemeResource TertiaryTextBrush}"
                        Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" />
                    <Button
                        x:Name="CountdownChip"
                        Padding="0"
                        AutomationProperties.AutomationId="DepartureCountdownChip"
                        AutomationProperties.Name="{x:Bind ViewModel.Countdown, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCountdownChipClick"
                        ToolTipService.ToolTip="Open CA 2207">
                        <Grid>
                            <Border
                                Background="{ThemeResource AttentionSoftBrush}"
                                BorderBrush="{ThemeResource AttentionBrush}"
                                Style="{StaticResource PillBorderStyle}"
                                Visibility="{x:Bind helpers:Ui.Hide(ViewModel.IsReleased), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse
                                        x:Name="ChipDot"
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource AttentionBrush}" />
                                    <TextBlock
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        Foreground="{ThemeResource AttentionBrush}"
                                        Style="{StaticResource PillTextStyle}"
                                        Text="{x:Bind ViewModel.FlightLabel, Mode=OneTime}" />
                                    <TextBlock
                                        Foreground="{ThemeResource PrimaryTextBrush}"
                                        Style="{StaticResource PillTextStyle}"
                                        Text="{x:Bind ViewModel.Countdown, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                    <TextBlock
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        Style="{StaticResource PillTextStyle}"
                                        Text="to departure" />
                                </StackPanel>
                            </Border>
                            <Border
                                Background="{ThemeResource HealthySoftBrush}"
                                BorderBrush="{ThemeResource HealthyBrush}"
                                Style="{StaticResource PillBorderStyle}"
                                Visibility="{x:Bind helpers:Ui.Show(ViewModel.IsReleased), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource HealthyBrush}"
                                        Glyph="&#xE73E;" />
                                    <TextBlock
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        Foreground="{ThemeResource HealthyBrush}"
                                        Style="{StaticResource PillTextStyle}"
                                        Text="{x:Bind ViewModel.FlightLabel, Mode=OneTime}" />
                                    <TextBlock
                                        Foreground="{ThemeResource PrimaryTextBrush}"
                                        Style="{StaticResource PillTextStyle}"
                                        Text="Released to service" />
                                    <TextBlock
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        Style="{StaticResource PillTextStyle}"
                                        Text="{x:Bind ViewModel.Countdown, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Button>
                    <PersonPicture
                        Width="32"
                        Height="32"
                        AutomationProperties.Name="Signed in as Maya Okafor, shift lead"
                        DisplayName="Maya Okafor"
                        ToolTipService.ToolTip="Maya Okafor · Shift lead" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AutomationProperties.AutomationId="MainNavigation"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavSelectionChanged"
            Style="{StaticResource MainNavigationViewStyle}">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavFleet"
                    Content="Fleet"
                    Tag="Fleet"
                    ToolTipService.ToolTip="Fleet">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE709;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavAircraft"
                    Content="Aircraft"
                    Tag="Aircraft"
                    ToolTipService.ToolTip="Aircraft">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF158;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavWorkOrdersItem"
                    AutomationProperties.AutomationId="NavWorkOrders"
                    Content="Work Orders"
                    Tag="WorkOrders"
                    ToolTipService.ToolTip="Work Orders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="WorkOrderBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavInspections"
                    Content="Inspections"
                    Tag="Inspections"
                    ToolTipService.ToolTip="Inspections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDC6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="RootFrame" />
        </NavigationView>

        <InfoBar
            x:Name="ResetInfoBar"
            Grid.Row="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="False"
            Message="Demo state restored to 02:40 · CA 2207 Engine 2 vibration exceedance."
            Severity="Informational"
            Title="Demo reset" />

        <controls:AskHangarPane
            x:Name="AskPane"
            Grid.Row="1"
            Grid.Column="1" />
    </Grid>
</Window>
