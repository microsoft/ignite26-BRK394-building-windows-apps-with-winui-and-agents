<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Hangar.Controls.AircraftStage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="AircraftStage"
    AutomationProperties.Name="Aircraft stage. Drag or use the arrow keys to orbit."
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <UserControl.Resources>
        <RadialGradientBrush x:Key="StageShadowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="{ThemeResource StageShadowColor}" />
            <GradientStop Offset="1" Color="Transparent" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="HeatGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="{ThemeResource AttentionColor}" />
            <GradientStop Offset="0.45" Color="{ThemeResource HeatMidColor}" />
            <GradientStop Offset="1" Color="Transparent" />
        </RadialGradientBrush>

        <Style x:Key="StagePartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Margin="-14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18" />
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PartLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="PartNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource MonoTextStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Background="Transparent"
        ManipulationCompleted="OnManipulationCompleted"
        ManipulationDelta="OnManipulationDelta"
        ManipulationMode="TranslateX,TranslateY,TranslateInertia"
        ManipulationStarted="OnManipulationStarted">
        <Viewbox Stretch="Uniform">
            <Grid Width="1600" Height="900">
                <!--  Hangar floor  -->
                <Ellipse
                    Canvas.ZIndex="0"
                    Width="1500"
                    Height="760"
                    Margin="50,120,50,20"
                    Fill="{ThemeResource StageGlowBrush}" />
                <Path
                    x:Name="FloorGrid"
                    Stroke="{ThemeResource StageFloorBrush}"
                    StrokeThickness="1.2" />
                <Ellipse
                    x:Name="FloorShadow"
                    Width="1240"
                    Height="80"
                    Margin="80,585,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="{StaticResource StageShadowBrush}"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="ShadowScale" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!--  Mirror of the airframe, created with a CompositionVisualSurface  -->
                <Grid x:Name="ReflectionHost" IsHitTestVisible="False" />

                <Grid x:Name="SceneHost">
                    <Grid x:Name="Scene">
                        <Grid.Transform3D>
                            <PerspectiveTransform3D Depth="1600" />
                        </Grid.Transform3D>

                        <Canvas x:Name="Airframe" Width="1600" Height="900">
                            <Canvas.Transform3D>
                                <CompositeTransform3D
                                    x:Name="AirframeTransform"
                                    CenterX="880"
                                    CenterY="380"
                                    CenterZ="0" />
                            </Canvas.Transform3D>

                            <!--  Far side: port wing + stabiliser  -->
                            <Canvas Width="1600" Height="900">
                                <Canvas.Transform3D>
                                    <CompositeTransform3D TranslateZ="-90" />
                                </Canvas.Transform3D>
                                <Path
                                    Data="M 940,262 L 790,128 L 752,126 L 800,262 Z"
                                    Fill="{ThemeResource WingBrush}"
                                    Opacity="0.75" />
                                <Path
                                    Data="M 250,268 L 170,218 L 140,218 L 300,272 Z"
                                    Fill="{ThemeResource WingBrush}"
                                    Opacity="0.75" />
                            </Canvas>

                            <!--  Body  -->
                            <Canvas Width="1600" Height="900">
                                <Path
                                    Data="M 1318,350 L 1318,592 M 660,350 L 660,588 M 700,350 L 700,588"
                                    Stroke="{ThemeResource MetalBrush}"
                                    StrokeThickness="9" />
                                <Ellipse
                                    Canvas.Left="1300"
                                    Canvas.Top="586"
                                    Width="36"
                                    Height="36"
                                    Fill="{ThemeResource AircraftShadeBrush}"
                                    Stroke="{ThemeResource MetalBrush}"
                                    StrokeThickness="5" />
                                <Ellipse
                                    Canvas.Left="634"
                                    Canvas.Top="576"
                                    Width="48"
                                    Height="48"
                                    Fill="{ThemeResource AircraftShadeBrush}"
                                    Stroke="{ThemeResource MetalBrush}"
                                    StrokeThickness="6" />
                                <Ellipse
                                    Canvas.Left="678"
                                    Canvas.Top="576"
                                    Width="48"
                                    Height="48"
                                    Fill="{ThemeResource AircraftShadeBrush}"
                                    Stroke="{ThemeResource MetalBrush}"
                                    StrokeThickness="6" />
                                <Path Data="M 244,254 L 132,70 L 214,64 L 446,254 Z" Fill="{ThemeResource TailBrush}" />
                                <Path
                                    Data="M 196,104 C 214,124 226,150 232,178"
                                    Opacity="0.7"
                                    Stroke="{ThemeResource FuselageBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="10" />
                                <Path Data="M 232,250 L 1300,250 C 1392,250 1455,280 1466,306 C 1452,336 1392,360 1300,362 L 540,362 C 410,362 296,332 202,276 L 180,262 C 190,252 206,250 232,250 Z" Fill="{ThemeResource FuselageBrush}" />
                                <Path
                                    Data="M 520,338 L 1310,338 C 1360,338 1400,330 1430,318"
                                    Stroke="{ThemeResource AccentCyanBrush}"
                                    StrokeThickness="4" />
                                <Path Data="M 1384,270 L 1428,278 L 1440,292 L 1392,290 Z" Fill="{ThemeResource AircraftWindowBrush}" />
                                <Line
                                    StrokeDashArray="0.9,1.7"
                                    Stroke="{ThemeResource AircraftWindowBrush}"
                                    StrokeThickness="8"
                                    X1="430"
                                    X2="1336"
                                    Y1="284"
                                    Y2="284" />
                                <Rectangle
                                    Canvas.Left="1334"
                                    Canvas.Top="266"
                                    Width="22"
                                    Height="58"
                                    RadiusX="5"
                                    RadiusY="5"
                                    Stroke="{ThemeResource AircraftShadeBrush}"
                                    StrokeThickness="1.5" />
                                <Rectangle
                                    Canvas.Left="392"
                                    Canvas.Top="264"
                                    Width="20"
                                    Height="56"
                                    RadiusX="5"
                                    RadiusY="5"
                                    Stroke="{ThemeResource AircraftShadeBrush}"
                                    StrokeThickness="1.5" />
                                <TextBlock
                                    Canvas.Left="590"
                                    Canvas.Top="296"
                                    CharacterSpacing="420"
                                    FontFamily="{StaticResource DisplayFontFamily}"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AircraftWindowBrush}"
                                    Text="CONTOSO AERO" />
                                <TextBlock
                                    Canvas.Left="300"
                                    Canvas.Top="300"
                                    FontFamily="{StaticResource MonoFontFamily}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AircraftShadeBrush}"
                                    Text="N2207C" />
                            </Canvas>

                            <!--  Near side: starboard wing, Engine 2  -->
                            <Canvas Width="1600" Height="900">
                                <Canvas.Transform3D>
                                    <CompositeTransform3D TranslateZ="90" />
                                </Canvas.Transform3D>
                                <Path Data="M 236,300 L 118,352 L 168,356 L 336,308 Z" Fill="{ThemeResource WingBrush}" />
                                <Path Data="M 990,334 L 640,564 L 588,572 L 692,344 Z" Fill="{ThemeResource WingBrush}" />
                                <Path
                                    Data="M 990,334 L 640,564"
                                    Opacity="0.8"
                                    Stroke="{ThemeResource FuselageBrush}"
                                    StrokeThickness="3" />
                                <Path Data="M 588,572 L 566,520 L 580,516 L 612,566 Z" Fill="{ThemeResource TailBrush}" />
                                <Path Data="M 826,420 L 904,366 L 980,378 L 964,414 Z" Fill="{ThemeResource WingBrush}" />

                                <!--  Engine core (hidden inside the nacelle until exploded)  -->
                                <Button
                                    x:Name="TurbineButton"
                                    Canvas.Left="770"
                                    Canvas.Top="410"
                                    AutomationProperties.AutomationId="StagePartTurbine"
                                    AutomationProperties.Name="Turbine"
                                    Click="OnPartClick"
                                    Style="{StaticResource StagePartButtonStyle}"
                                    Tag="Turbine">
                                    <Canvas x:Name="TurbinePart" Width="110" Height="120">
                                        <Ellipse
                                            x:Name="TurbineHeat"
                                            Canvas.Left="-50"
                                            Canvas.Top="-40"
                                            Width="210"
                                            Height="200"
                                            Fill="{StaticResource HeatGlowBrush}"
                                            Opacity="0" />
                                        <Rectangle
                                            Canvas.Left="0"
                                            Canvas.Top="54"
                                            Width="110"
                                            Height="12"
                                            Fill="{ThemeResource MetalBrush}" />
                                        <Ellipse Canvas.Left="6" Canvas.Top="8" Width="18" Height="104" Fill="{ThemeResource HotMetalBrush}" Stroke="{ThemeResource MetalBrush}" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="30" Canvas.Top="12" Width="18" Height="96" Fill="{ThemeResource HotMetalBrush}" Stroke="{ThemeResource MetalBrush}" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="54" Canvas.Top="16" Width="18" Height="88" Fill="{ThemeResource HotMetalBrush}" Stroke="{ThemeResource MetalBrush}" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="78" Canvas.Top="22" Width="18" Height="76" Fill="{ThemeResource HotMetalBrush}" Stroke="{ThemeResource MetalBrush}" StrokeThickness="2" />
                                        <StackPanel
                                            x:Name="TurbineLabel"
                                            Canvas.Left="0"
                                            Canvas.Top="132"
                                            Opacity="0">
                                            <TextBlock Style="{StaticResource PartLabelStyle}" Text="TURBINE" />
                                            <TextBlock Style="{StaticResource PartNumberStyle}" Text="LPT 7-stage" />
                                        </StackPanel>
                                    </Canvas>
                                </Button>
                                <Button
                                    x:Name="CompressorButton"
                                    Canvas.Left="865"
                                    Canvas.Top="408"
                                    AutomationProperties.AutomationId="StagePartCompressor"
                                    AutomationProperties.Name="Compressor"
                                    Click="OnPartClick"
                                    Style="{StaticResource StagePartButtonStyle}"
                                    Tag="Compressor">
                                    <Canvas x:Name="CompressorPart" Width="120" Height="124">
                                        <Path Data="M 0,44 L 120,14 L 120,110 L 0,80 Z" Fill="{ThemeResource NacelleBrush}" Opacity="0.55" />
                                        <Ellipse Canvas.Left="4" Canvas.Top="32" Width="14" Height="60" Fill="{ThemeResource MetalBrush}" Stroke="{ThemeResource NacelleBrush}" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="22" Canvas.Top="28" Width="14" Height="68" Fill="{ThemeResource MetalBrush}" Stroke="{ThemeResource NacelleBrush}" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="40" Canvas.Top="24" Width="14" Height="76" Fill="{ThemeResource MetalBrush}" Stroke="{ThemeResource NacelleBrush}" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="58" Canvas.Top="20" Width="14" Height="84" Fill="{ThemeResource MetalBrush}" Stroke="{ThemeResource NacelleBrush}" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="76" Canvas.Top="16" Width="14" Height="92" Fill="{ThemeResource MetalBrush}" Stroke="{ThemeResource NacelleBrush}" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="94" Canvas.Top="12" Width="14" Height="100" Fill="{ThemeResource MetalBrush}" Stroke="{ThemeResource NacelleBrush}" StrokeThickness="2" />
                                        <StackPanel
                                            x:Name="CompressorLabel"
                                            Canvas.Left="0"
                                            Canvas.Top="136"
                                            Opacity="0">
                                            <TextBlock Style="{StaticResource PartLabelStyle}" Text="COMPRESSOR" />
                                            <TextBlock Style="{StaticResource PartNumberStyle}" Text="HPC 8-stage" />
                                        </StackPanel>
                                    </Canvas>
                                </Button>
                                <Button
                                    x:Name="FanButton"
                                    Canvas.Left="962"
                                    Canvas.Top="396"
                                    AutomationProperties.AutomationId="StagePartFan"
                                    AutomationProperties.Name="Fan"
                                    Click="OnPartClick"
                                    Style="{StaticResource StagePartButtonStyle}"
                                    Tag="Fan">
                                    <Canvas x:Name="FanPart" Width="90" Height="148">
                                        <Ellipse
                                            x:Name="FanDisc"
                                            Canvas.Left="12"
                                            Canvas.Top="4"
                                            Width="56"
                                            Height="140"
                                            Fill="{ThemeResource MetalBrush}"
                                            Stroke="{ThemeResource NacelleBrush}"
                                            StrokeThickness="3" />
                                        <Path
                                            x:Name="FanBlades"
                                            Stroke="{ThemeResource FuselageBrush}"
                                            StrokeThickness="2" />
                                        <Path Data="M 40,56 C 62,60 74,70 77,74 C 74,78 62,88 40,92 Z" Fill="{ThemeResource NacelleBrush}" />
                                        <StackPanel
                                            x:Name="FanLabel"
                                            Canvas.Left="0"
                                            Canvas.Top="160"
                                            Opacity="0">
                                            <TextBlock Style="{StaticResource PartLabelStyle}" Text="FAN" />
                                            <TextBlock Style="{StaticResource PartNumberStyle}" Text="2307M41P04" />
                                        </StackPanel>
                                    </Canvas>
                                </Button>

                                <Button
                                    x:Name="NacelleButton"
                                    Canvas.Left="690"
                                    Canvas.Top="396"
                                    AutomationProperties.AutomationId="StagePartNacelle"
                                    AutomationProperties.Name="Nacelle"
                                    Click="OnPartClick"
                                    Style="{StaticResource StagePartButtonStyle}"
                                    Tag="Nacelle">
                                    <Canvas x:Name="NacellePart" Width="350" Height="148">
                                        <Path Data="M 62,50 L 8,62 L 8,86 L 62,98 Z" Fill="{ThemeResource MetalBrush}" />
                                        <Path Data="M 8,66 L -16,74 L 8,82 Z" Fill="{ThemeResource HotMetalBrush}" />
                                        <Path
                                            x:Name="NacelleShell"
                                            Data="M 90,19 L 300,12 C 325,12 340,44 340,74 C 340,104 325,136 300,136 L 100,129 C 80,119 65,99 62,74 C 65,49 80,29 90,19 Z"
                                            Fill="{ThemeResource NacelleBrush}" />
                                        <Path
                                            Data="M 118,38 L 292,32"
                                            Opacity="0.7"
                                            Stroke="{ThemeResource FuselageBrush}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="3" />
                                        <Path
                                            Data="M 100,112 L 300,116"
                                            Stroke="{ThemeResource AccentCyanBrush}"
                                            StrokeThickness="3" />
                                        <Ellipse
                                            Canvas.Left="312"
                                            Canvas.Top="16"
                                            Width="30"
                                            Height="116"
                                            Fill="{ThemeResource AircraftShadeBrush}"
                                            Stroke="{ThemeResource FuselageBrush}"
                                            StrokeThickness="4" />
                                        <Ellipse
                                            x:Name="NacelleHeat"
                                            Canvas.Left="20"
                                            Canvas.Top="4"
                                            Width="250"
                                            Height="140"
                                            Fill="{StaticResource HeatGlowBrush}"
                                            Opacity="0" />
                                        <StackPanel
                                            x:Name="NacelleLabel"
                                            Canvas.Left="120"
                                            Canvas.Top="-62"
                                            Opacity="0">
                                            <TextBlock Style="{StaticResource PartLabelStyle}" Text="NACELLE" />
                                            <TextBlock Style="{StaticResource PartNumberStyle}" Text="ENG 2 · ESN 598-117" />
                                        </StackPanel>
                                    </Canvas>
                                </Button>

                                <!--  Status ring around Engine 2  -->
                                <Grid
                                    x:Name="Ring"
                                    Canvas.Left="650"
                                    Canvas.Top="352"
                                    Width="440"
                                    Height="236"
                                    IsHitTestVisible="False">
                                    <Ellipse
                                        x:Name="Burst"
                                        Opacity="0"
                                        Stroke="{ThemeResource HealthyBrush}"
                                        StrokeThickness="4" />
                                    <Ellipse
                                        x:Name="RingGlow"
                                        Stroke="{ThemeResource AttentionSoftBrush}"
                                        StrokeThickness="14" />
                                    <Ellipse
                                        x:Name="RingLine"
                                        Stroke="{ThemeResource AttentionBrush}"
                                        StrokeDashArray="6,3"
                                        StrokeThickness="3" />
                                </Grid>
                            </Canvas>
                        </Canvas>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
