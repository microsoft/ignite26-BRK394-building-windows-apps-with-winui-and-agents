<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Hangar.Controls.AircraftStage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    AutomationProperties.AutomationId="AircraftStage"
    AutomationProperties.Name="Holographic aircraft. Drag or use the arrow keys to orbit, click an Engine 2 part to zoom in."
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <Grid x:Name="Root" Background="Transparent">
        <canvas:CanvasControl
            x:Name="Canvas"
            ClearColor="Transparent"
            Draw="OnDraw"
            PointerExited="OnPointerExited"
            PointerMoved="OnPointerMoved"
            PointerPressed="OnPointerPressed"
            PointerReleased="OnPointerReleased"
            PointerWheelChanged="OnPointerWheelChanged" />
    </Grid>
</UserControl>
