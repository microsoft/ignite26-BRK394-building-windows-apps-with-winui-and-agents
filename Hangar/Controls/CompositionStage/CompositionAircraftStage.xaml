<UserControl
    x:Class="Hangar.Controls.CompositionAircraftStage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="StageControl"
    AutomationProperties.AutomationId="CompositionAircraftStage"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    mc:Ignorable="d">
    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerCanceled="OnPointerCanceled"
        PointerExited="OnPointerExited"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        PointerWheelChanged="OnPointerWheelChanged"
        SizeChanged="OnSizeChanged">
        <Grid x:Name="Host" AutomationProperties.AccessibilityView="Raw" />
        <Canvas x:Name="LabelLayer" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" Opacity="0" />
    </Grid>
</UserControl>