<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Hangar.Controls.KpiCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorderStyle}" Padding="20,18,20,12">
        <Grid RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="{x:Bind Label, Mode=OneWay}" />
            <TextBlock
                Grid.Row="1"
                Style="{StaticResource KpiValueTextStyle}"
                Text="{x:Bind Value, Mode=OneWay}" />
            <TextBlock
                Grid.Row="2"
                Foreground="{ThemeResource SecondaryTextBrush}"
                Style="{StaticResource BodyTextStyle}"
                FontSize="12"
                Text="{x:Bind Caption, Mode=OneWay}" />
            <!--  Sparkline drawn as Paths: the experimental Chart leaves gaps at this size (see README).  -->
            <Grid
                x:Name="Spark"
                Grid.Row="3"
                Margin="0,8,0,2"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                SizeChanged="OnSparkSizeChanged">
                <Path x:Name="SparkArea" />
                <Path
                    x:Name="SparkLine"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="2" />
                <Ellipse
                    x:Name="SparkDot"
                    Width="7"
                    Height="7"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
