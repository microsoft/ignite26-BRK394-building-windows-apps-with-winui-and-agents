<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        "Night Shift" palette. Semantic names only: usage sites reference these
        keys through {ThemeResource}, never raw hex values.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ===================== Night Shift (Dark) ===================== -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#3AD1F0</Color>
            <Color x:Key="SystemAccentColorLight1">#6BDDF4</Color>
            <Color x:Key="SystemAccentColorLight2">#9BE8F8</Color>
            <Color x:Key="SystemAccentColorLight3">#CDF4FC</Color>
            <Color x:Key="SystemAccentColorDark1">#22B5D4</Color>
            <Color x:Key="SystemAccentColorDark2">#1590AB</Color>
            <Color x:Key="SystemAccentColorDark3">#0B6A80</Color>

            <Color x:Key="CanvasColor">#0B0F14</Color>
            <Color x:Key="AccentCyanColor">#3AD1F0</Color>
            <Color x:Key="AttentionColor">#FFB020</Color>
            <Color x:Key="CriticalColor">#FF5A5F</Color>
            <Color x:Key="HealthyColor">#4ADE80</Color>
            <Color x:Key="ChartGridColor">#1FFFFFFF</Color>

            <SolidColorBrush x:Key="CanvasBrush" Color="#0B0F14" />
            <SolidColorBrush x:Key="CanvasTintBrush" Color="#CC0B0F14" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GlassBrush" Color="#B3111820" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="AccentCyanBrush" Color="#3AD1F0" />
            <SolidColorBrush x:Key="AccentCyanSoftBrush" Color="#333AD1F0" />
            <SolidColorBrush x:Key="AttentionBrush" Color="#FFB020" />
            <SolidColorBrush x:Key="AttentionSoftBrush" Color="#33FFB020" />
            <SolidColorBrush x:Key="CriticalBrush" Color="#FF5A5F" />
            <SolidColorBrush x:Key="CriticalSoftBrush" Color="#33FF5A5F" />
            <SolidColorBrush x:Key="HealthyBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="HealthySoftBrush" Color="#334ADE80" />
            <SolidColorBrush x:Key="NeutralStatusBrush" Color="#8A96A3" />
            <SolidColorBrush x:Key="NeutralSoftBrush" Color="#268A96A3" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F6FA" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A9B4BF" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6B7682" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ChartTargetBrush" Color="#80F2F6FA" />
            <SolidColorBrush x:Key="ChartBandBrush" Color="#263AD1F0" />
            <SolidColorBrush x:Key="AircraftBodyBrush" Color="#C9D3DD" />
            <SolidColorBrush x:Key="AircraftShadeBrush" Color="#7C8995" />
            <SolidColorBrush x:Key="AircraftWindowBrush" Color="#1A2430" />
            <SolidColorBrush x:Key="InkSurfaceBrush" Color="#000000" />

            <LinearGradientBrush x:Key="AccentAreaBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#803AD1F0" />
                <GradientStop Offset="1" Color="#003AD1F0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AttentionAreaBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#80FFB020" />
                <GradientStop Offset="1" Color="#00FFB020" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HealthyAreaBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#664ADE80" />
                <GradientStop Offset="1" Color="#004ADE80" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CriticalAreaBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#66FF5A5F" />
                <GradientStop Offset="1" Color="#00FF5A5F" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="StageGlowBrush" Center="0.5,0.55" RadiusX="0.6" RadiusY="0.55" GradientOrigin="0.5,0.55">
                <GradientStop Offset="0" Color="#2E3AD1F0" />
                <GradientStop Offset="0.55" Color="#0D3AD1F0" />
                <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="StageFloorBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="0.6" Color="#40000000" />
                <GradientStop Offset="1" Color="#99000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="FuselageBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#F4F8FB" />
                <GradientStop Offset="0.45" Color="#C9D3DD" />
                <GradientStop Offset="1" Color="#5D6A76" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="WingBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#B8C3CE" />
                <GradientStop Offset="1" Color="#6A7784" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TailBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#3AD1F0" />
                <GradientStop Offset="1" Color="#1478A0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NacelleBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#E6ECF1" />
                <GradientStop Offset="0.5" Color="#A2AEBA" />
                <GradientStop Offset="1" Color="#47525D" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#9AA6B2" />
                <GradientStop Offset="0.5" Color="#5B6672" />
                <GradientStop Offset="1" Color="#2B333B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HotMetalBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#C59A6A" />
                <GradientStop Offset="0.5" Color="#7A5634" />
                <GradientStop Offset="1" Color="#3A2818" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="1" Color="#CC0B0F14" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ===================== Day Shift (Light) ===================== -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#0E9FC0</Color>
            <Color x:Key="SystemAccentColorLight1">#3AD1F0</Color>
            <Color x:Key="SystemAccentColorLight2">#6BDDF4</Color>
            <Color x:Key="SystemAccentColorLight3">#9BE8F8</Color>
            <Color x:Key="SystemAccentColorDark1">#0B86A3</Color>
            <Color x:Key="SystemAccentColorDark2">#086B83</Color>
            <Color x:Key="SystemAccentColorDark3">#054F61</Color>

            <Color x:Key="CanvasColor">#F4F6F8</Color>
            <Color x:Key="AccentCyanColor">#0E9FC0</Color>
            <Color x:Key="AttentionColor">#C77700</Color>
            <Color x:Key="CriticalColor">#D13438</Color>
            <Color x:Key="HealthyColor">#14834A</Color>
            <Color x:Key="ChartGridColor">#1F000000</Color>

            <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F8" />
            <SolidColorBrush x:Key="CanvasTintBrush" Color="#CCF4F6F8" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#14000000" />
            <SolidColorBrush x:Key="GlassBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="AccentCyanBrush" Color="#0E9FC0" />
            <SolidColorBrush x:Key="AccentCyanSoftBrush" Color="#260E9FC0" />
            <SolidColorBrush x:Key="AttentionBrush" Color="#C77700" />
            <SolidColorBrush x:Key="AttentionSoftBrush" Color="#26FFB020" />
            <SolidColorBrush x:Key="CriticalBrush" Color="#D13438" />
            <SolidColorBrush x:Key="CriticalSoftBrush" Color="#26D13438" />
            <SolidColorBrush x:Key="HealthyBrush" Color="#14834A" />
            <SolidColorBrush x:Key="HealthySoftBrush" Color="#2614834A" />
            <SolidColorBrush x:Key="NeutralStatusBrush" Color="#5F6B77" />
            <SolidColorBrush x:Key="NeutralSoftBrush" Color="#1F5F6B77" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0B0F14" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#46515C" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#77828D" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#14000000" />
            <SolidColorBrush x:Key="ChartTargetBrush" Color="#800B0F14" />
            <SolidColorBrush x:Key="ChartBandBrush" Color="#260E9FC0" />
            <SolidColorBrush x:Key="AircraftBodyBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AircraftShadeBrush" Color="#A9B4BF" />
            <SolidColorBrush x:Key="AircraftWindowBrush" Color="#2A3440" />
            <SolidColorBrush x:Key="InkSurfaceBrush" Color="#000000" />

            <LinearGradientBrush x:Key="AccentAreaBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#660E9FC0" />
                <GradientStop Offset="1" Color="#000E9FC0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AttentionAreaBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#66C77700" />
                <GradientStop Offset="1" Color="#00C77700" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HealthyAreaBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#5514834A" />
                <GradientStop Offset="1" Color="#0014834A" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CriticalAreaBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#55D13438" />
                <GradientStop Offset="1" Color="#00D13438" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="StageGlowBrush" Center="0.5,0.55" RadiusX="0.6" RadiusY="0.55" GradientOrigin="0.5,0.55">
                <GradientStop Offset="0" Color="#330E9FC0" />
                <GradientStop Offset="0.55" Color="#110E9FC0" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="StageFloorBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#1A000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="FuselageBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="0.5" Color="#E3E9EE" />
                <GradientStop Offset="1" Color="#8E9AA6" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="WingBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#D7DEE5" />
                <GradientStop Offset="1" Color="#909CA8" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TailBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#3AD1F0" />
                <GradientStop Offset="1" Color="#0B6A80" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NacelleBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="0.5" Color="#C3CCD5" />
                <GradientStop Offset="1" Color="#6E7984" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#B8C2CC" />
                <GradientStop Offset="0.5" Color="#7B8692" />
                <GradientStop Offset="1" Color="#4A535C" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HotMetalBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#D9B48A" />
                <GradientStop Offset="0.5" Color="#9C7550" />
                <GradientStop Offset="1" Color="#5A402A" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#CCF4F6F8" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ===================== High Contrast ===================== -->
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="CanvasColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AccentCyanColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AttentionColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="CriticalColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HealthyColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="ChartGridColor" ResourceKey="SystemColorGrayTextColor" />

            <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CanvasTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentCyanBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentCyanSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AttentionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AttentionSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CriticalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CriticalSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HealthyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HealthySoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NeutralStatusBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="NeutralSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ChartTargetBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartBandBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AircraftBodyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AircraftShadeBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AircraftWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InkSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentAreaBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.4" />
            <SolidColorBrush x:Key="AttentionAreaBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.4" />
            <SolidColorBrush x:Key="HealthyAreaBrush" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="0.3" />
            <SolidColorBrush x:Key="CriticalAreaBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.4" />
            <SolidColorBrush x:Key="StageGlowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StageFloorBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FuselageBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WingBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TailBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NacelleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MetalBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="HotMetalBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="HeroScrimBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
