<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Hangar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="SceneHost" Background="#606870" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="8" Margin="24">
            <ToggleButton x:Name="ExplodeToggle" Content="Explode" Click="OnExplode" />
            <Button Content="Orbit" Click="OnOrbit" />
        </StackPanel>
    </Grid>
</Page>
