<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Hangar.Views.AircraftPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Microsoft.UI.Xaml.Controls.Charts"
    xmlns:controls="using:Hangar.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="VitalLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowTextStyle}">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="VitalValueStyle" TargetType="TextBlock" BasedOn="{StaticResource KpiValueTextStyle}">
            <Setter Property="FontSize" Value="22" />
        </Style>
        <Style x:Key="PartChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <!--  Full-bleed stage: the aircraft is the canvas, everything else floats over it  -->
        <controls:AircraftStage
            x:Name="Stage"
            FocusPadding="380,150,480,120"
            ExplodedChanged="OnStageExplodedChanged"
            FaultInvoked="OnStageFaultInvoked"
            DiveCompleted="OnStageDiveCompleted"
            PartSelected="OnStagePartSelected" />

        <Grid Padding="40,28,40,28" ColumnSpacing="24" RowSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <StackPanel Grid.ColumnSpan="2" Spacing="2">
                <TextBlock x:Name="EyebrowText" Style="{StaticResource EyebrowTextStyle}" Text="CA 2207 · A321NEO · SEA → JFK 06:15" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <TextBlock
                        x:Name="HeaderTail"
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="56"
                        Style="{StaticResource TailTextStyle}"
                        Text="N2207C" />
                    <Border
                        x:Name="StatusPill"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AircraftStatusPill"
                        Style="{StaticResource PillBorderStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource PillTextStyle}" Text="Engine 2 vibration · hold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!--  Left column: vitals + network globe card  -->
            <Grid x:Name="LeftColumn" Grid.Row="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            <Border
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="AircraftVitalsPanel"
                AutomationProperties.Name="Aircraft vitals"
                Style="{StaticResource GlassPanelStyle}">
                <StackPanel Padding="20,16,20,18" Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Vitals" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource VitalLabelStyle}" Text="CYCLES" />
                            <TextBlock x:Name="CyclesText" Style="{StaticResource VitalValueStyle}" Text="8,412" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource VitalLabelStyle}" Text="FLIGHT HOURS" />
                            <TextBlock x:Name="HoursText" Style="{StaticResource VitalValueStyle}" Text="19,877" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="2">
                            <TextBlock Style="{StaticResource VitalLabelStyle}" Text="NEXT CHECK" />
                            <TextBlock x:Name="NextCheckText" Style="{StaticResource VitalValueStyle}" Text="23 d" />
                            <TextBlock x:Name="NextCheckKind" Foreground="{ThemeResource TertiaryTextBrush}" Style="{StaticResource BodyTextStyle}" Text="A-check" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource VitalLabelStyle}" Text="STATION" />
                            <TextBlock x:Name="StationText" Style="{StaticResource VitalValueStyle}" Text="SEA" />
                            <TextBlock Foreground="{ThemeResource TertiaryTextBrush}" Style="{StaticResource BodyTextStyle}" Text="Hangar 3 · Bay 2" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource GlassStrokeBrush}" />

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource VitalLabelStyle}" Text="ENGINE 2 · LEAP-1A" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" Style="{StaticResource BodyTextStyle}" Text="N1 vibration · last" />
                            <TextBlock
                                x:Name="LastVibText"
                                Grid.Column="1"
                                Foreground="{ThemeResource AttentionBrush}"
                                Style="{StaticResource MonoTextStyle}"
                                Text="2.31 ips" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" Style="{StaticResource BodyTextStyle}" Text="Limit" />
                            <TextBlock Grid.Column="1" Foreground="{ThemeResource SecondaryTextBrush}" Style="{StaticResource MonoTextStyle}" Text="1.80 ips" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" Style="{StaticResource BodyTextStyle}" Text="ESN" />
                            <TextBlock Grid.Column="1" Foreground="{ThemeResource SecondaryTextBrush}" Style="{StaticResource MonoTextStyle}" Text="598-214" />
                        </Grid>
                    </StackPanel>

                    <Button
                        x:Name="WorkOrdersButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="AircraftWorkOrdersButton"
                        Click="OnWorkOrdersClick"
                        CornerRadius="{StaticResource PillCornerRadius}"
                        Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="14" Glyph="&#xE9D5;" />
                            <TextBlock x:Name="WorkOrdersButtonText" Text="Engine 2 work orders" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Compact network globe card: the globe itself renders in the full-bleed overlay below, aligned to GlobeSlot  -->
            <Border
                x:Name="GlobeCard"
                Grid.Row="1"
                MinHeight="240"
                MaxHeight="360"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="GlobeCard"
                AutomationProperties.Name="Fleet network globe. Press G or Enter to expand"
                IsTabStop="True"
                KeyDown="OnGlobeCardKeyDown"
                PointerEntered="OnGlobeCardPointerEntered"
                PointerExited="OnGlobeCardPointerExited"
                Style="{StaticResource GlassPanelStyle}"
                Tapped="OnGlobeCardTapped"
                UseSystemFocusVisuals="True">
                <Grid Padding="24,18,24,18" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="NETWORK · 02:40 PT" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentCyanBrush}" />
                        <TextBlock
                            x:Name="AirborneText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Style="{StaticResource MonoTextStyle}"
                            FontSize="12"
                            Text="12 airborne" />
                    </StackPanel>
                    <Border x:Name="GlobeSlot" Grid.Row="1" />
                    <TextBlock
                        x:Name="GlobeHint"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TertiaryTextBrush}"
                        Style="{StaticResource MonoTextStyle}"
                        FontSize="11"
                        Opacity="0"
                        Text="G · expand" />

                    <!--  Compact caption for the flight-44 crew report: own row, never overlays the header  -->
                    <StackPanel
                        x:Name="HailCaption"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="HailCaption"
                        AutomationProperties.Name="Flight 44, Denver to Seattle. Crew report: hail encounter on climb, flight level 190"
                        Opacity="0"
                        Spacing="2"
                        ToolTipService.ToolTip="FLT 44 · DEN → SEA · Crew report: hail encounter on climb, FL190">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AttentionBrush}" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Text="FLT 44 · DEN → SEA" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            MaxLines="1"
                            Text="Crew report: hail encounter on climb, FL190"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>

                    <!--  Expanded state: legend + FLT 44 detail fill the card while the globe owns the stage  -->
                    <StackPanel
                        x:Name="GlobeExpandedPanel"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        AutomationProperties.AutomationId="GlobeExpandedPanel"
                        Opacity="0"
                        Spacing="14"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="LEGEND" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource AttentionBrush}" />
                                <TextBlock FontSize="13" Foreground="{ThemeResource PrimaryTextBrush}" Text="CA 2207 · parked SEA" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource AccentCyanBrush}" />
                                <TextBlock x:Name="LegendAirborneText" FontSize="13" Foreground="{ThemeResource PrimaryTextBrush}" Text="Airborne fleet (12)" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="14" Height="3" VerticalAlignment="Center" Fill="{ThemeResource CriticalBrush}" RadiusX="1.5" RadiusY="1.5" />
                                <TextBlock FontSize="13" Foreground="{ThemeResource PrimaryTextBrush}" Text="FLT 44 hail event" />
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Fill="{ThemeResource GlassStrokeBrush}" />
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="FLT 44 · CREW REPORT" />
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Text="DEN → SEA · FL190" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                Text="Hail encounter on climb, FL190."
                                TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AttentionBrush}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource AttentionBrush}"
                                    Style="{StaticResource MonoTextStyle}"
                                    Text="N1 VIB 1.32 IPS · STEP CHANGE" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>

            <!--  Right glass: Engine 2 vibration chart  -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="VibrationPanel"
                AutomationProperties.Name="Engine 2 vibration, last 50 flights"
                Style="{StaticResource GlassPanelStyle}">
                <StackPanel Padding="24,22,24,20" Spacing="14">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ENGINE 2 · N1 VIBRATION" />
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Last 50 flights" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="0">
                            <TextBlock
                                x:Name="ScrubValueText"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource AttentionBrush}"
                                Style="{StaticResource KpiValueTextStyle}"
                                FontSize="30"
                                Text="2.31" />
                            <TextBlock
                                x:Name="ScrubFlightText"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TertiaryTextBrush}"
                                Style="{StaticResource MonoTextStyle}"
                                FontSize="12"
                                Text="ips · flight 50" />
                        </StackPanel>
                    </Grid>

                    <charts:Chart
                        x:Name="VibrationChart"
                        Height="260"
                        AutomationProperties.AutomationId="VibrationChart"
                        AutomationProperties.Name="Engine 2 vibration chart with fleet average band and 1.8 threshold" />

                    <!--  Legend  -->
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="14" Height="3" VerticalAlignment="Center" Fill="{ThemeResource AttentionBrush}" />
                            <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" Text="CA 2207 Eng 2" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="14" Height="10" VerticalAlignment="Center" Fill="{ThemeResource ChartBandBrush}" />
                            <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" Text="Fleet average" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Line VerticalAlignment="Center" Stroke="{ThemeResource CriticalBrush}" StrokeDashArray="3,2" StrokeThickness="2" X1="0" X2="14" />
                            <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" Text="Limit 1.8" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{ThemeResource GlassStrokeBrush}" />

                    <!--  Selected part detail  -->
                    <StackPanel x:Name="PartDetail" Spacing="6">
                        <TextBlock x:Name="PartEyebrow" Style="{StaticResource EyebrowTextStyle}" Text="SELECTED PART" />
                        <TextBlock x:Name="PartTitle" Style="{StaticResource SectionTitleTextStyle}" Text="Tap a part to isolate it" />
                        <TextBlock
                            x:Name="PartBody"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Style="{StaticResource BodyTextStyle}"
                            Text="Explode Engine 2 to separate the nacelle, fan, compressor and turbine."
                            TextWrapping="WrapWholeWords" />
                        <Button
                            x:Name="BorescopeButton"
                            Margin="0,8,0,0"
                            Padding="16,10"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="AircraftBorescopeButton"
                            AutomationProperties.Name="Open borescope inspection for fan blade 14"
                            Click="OnBorescopeClick"
                            CornerRadius="{StaticResource PillCornerRadius}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE890;" />
                                <TextBlock Text="Borescope blade 14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Bottom dock: commands + timeline scrubber  -->
            <Border
                Grid.Row="2"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                Padding="16,10"
                Style="{StaticResource GlassPanelStyle}"
                CornerRadius="24">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ToggleButton
                        x:Name="ExplodeToggle"
                        AutomationProperties.AutomationId="ExplodeToggle"
                        AutomationProperties.Name="Explode Engine 2"
                        Checked="OnExplodeToggled"
                        CornerRadius="{StaticResource PillCornerRadius}"
                        Padding="16,8"
                        Unchecked="OnExplodeToggled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xF156;" />
                            <TextBlock FontWeight="SemiBold" Text="Explode" />
                        </StackPanel>
                        <ToggleButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="E" Modifiers="Control" />
                        </ToggleButton.KeyboardAccelerators>
                    </ToggleButton>

                    <StackPanel x:Name="PartChips" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ToggleButton x:Name="NacelleChip" AutomationProperties.AutomationId="PartChipNacelle" Click="OnPartChipClick" Content="Nacelle" Style="{StaticResource PartChipStyle}" Tag="Nacelle" />
                        <ToggleButton x:Name="FanChip" AutomationProperties.AutomationId="PartChipFan" Click="OnPartChipClick" Content="Fan" Style="{StaticResource PartChipStyle}" Tag="Fan" />
                        <ToggleButton x:Name="CompressorChip" AutomationProperties.AutomationId="PartChipCompressor" Click="OnPartChipClick" Content="Compressor" Style="{StaticResource PartChipStyle}" Tag="Compressor" />
                        <ToggleButton x:Name="TurbineChip" AutomationProperties.AutomationId="PartChipTurbine" Click="OnPartChipClick" Content="Turbine" Style="{StaticResource PartChipStyle}" Tag="Turbine" />
                    </StackPanel>

                    <Rectangle Width="1" Margin="0,4" Fill="{ThemeResource GlassStrokeBrush}" />

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" Glyph="&#xE81C;" />
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TertiaryTextBrush}" Style="{StaticResource MonoTextStyle}" FontSize="12" Text="FLT 1" />
                        <Slider
                            x:Name="Scrubber"
                            Width="360"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="FlightScrubber"
                            AutomationProperties.Name="Flight timeline"
                            IsThumbToolTipEnabled="False"
                            Maximum="49"
                            Minimum="0"
                            StepFrequency="1"
                            Value="49"
                            ValueChanged="OnScrubberChanged" />
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TertiaryTextBrush}" Style="{StaticResource MonoTextStyle}" FontSize="12" Text="FLT 50" />
                    </StackPanel>

                    <Rectangle Width="1" Margin="0,4" Fill="{ThemeResource GlassStrokeBrush}" />

                    <Button
                        x:Name="ResetViewButton"
                        AutomationProperties.AutomationId="ResetViewButton"
                        AutomationProperties.Name="Reset view"
                        Click="OnResetViewClick"
                        CornerRadius="{StaticResource PillCornerRadius}"
                        Padding="10,8"
                        ToolTipService.ToolTip="Reset view (Home)">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Fleet globe: one full-bleed render surface that animates between the card slot and the stage  -->
        <controls:FleetGlobe x:Name="Globe" ExpandProgressChanged="OnGlobeExpandProgressChanged" />

        <!--  Input layer for the expanded globe (drag to spin, wheel to zoom); hit-testable only while expanded  -->
        <Border
            x:Name="GlobeInput"
            Background="Transparent"
            IsHitTestVisible="False"
            PointerCanceled="OnGlobePointerReleased"
            PointerCaptureLost="OnGlobePointerReleased"
            PointerMoved="OnGlobePointerMoved"
            PointerPressed="OnGlobePointerPressed"
            PointerReleased="OnGlobePointerReleased"
            PointerWheelChanged="OnGlobePointerWheel" />

        <!--  Flight 44 crew report callout  -->
        <Border
            x:Name="HailCallout"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="HailCallout"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Flight 44, Denver to Seattle. Crew report: hail encounter on climb, flight level 190"
            IsHitTestVisible="False"
            Opacity="0"
            Style="{StaticResource PillBorderStyle}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HailCalloutShift" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource AttentionBrush}" />
                <TextBlock
                    x:Name="HailCalloutText"
                    MaxLines="1"
                    Style="{StaticResource PillTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap">
                    <Run FontWeight="SemiBold" Text="FLT 44 · DEN → SEA" />
                    <Run Foreground="{ThemeResource SecondaryTextBrush}" Text=" · Crew report: hail encounter on climb, FL190" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!--  Back chip shown while the globe is expanded  -->
        <Button
            x:Name="GlobeBackButton"
            Margin="0,0,0,110"
            Padding="16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="GlobeBackButton"
            AutomationProperties.Name="Back to aircraft"
            Click="OnGlobeBackClick"
            CornerRadius="{StaticResource PillCornerRadius}"
            Opacity="0"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon FontSize="12" Glyph="&#xE72B;" />
                <TextBlock Text="Back to aircraft" />
                <TextBlock Foreground="{ThemeResource TertiaryTextBrush}" Style="{StaticResource MonoTextStyle}" FontSize="12" Text="Esc" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
