<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Hangar.Views.InspectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <!--  Full-bleed borescope frame + ink overlay share one cell so strokes stay registered to the image  -->
        <Grid x:Name="ScopeHost">
            <Image
                x:Name="ScopeImage"
                AutomationProperties.Name="Borescope image of Engine 2 fan stage, blade 14 leading edge"
                Source="ms-appx:///Assets/Inspection/borescope.png"
                Stretch="UniformToFill" />
            <Rectangle
                Height="220"
                VerticalAlignment="Top"
                Fill="{ThemeResource HeroScrimBrush}"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform ScaleY="-1" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <InkCanvas x:Name="ScopeInk" AutomationProperties.AutomationId="InspectionInkCanvas" AutomationProperties.Name="Inspection annotation canvas" />
        </Grid>

        <!--  Header  -->
        <StackPanel
            Margin="40,28,40,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="2">
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CA 2207 · ENGINE 2 · FAN STAGE · BORESCOPE" />
            <StackPanel Orientation="Horizontal" Spacing="18">
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TailTextStyle}"
                    Text="{x:Bind Data.Hero.Tail, FallbackValue=N2207C}" />
                <Border
                    x:Name="StatusPill"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="InspectionStatusPill"
                    Style="{StaticResource PillBorderStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="StatusDot"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource PillTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{ThemeResource SecondaryTextBrush}"
                Style="{StaticResource BodyTextStyle}"
                Text="Probe BSI-4 · 6 mm articulating · captured 02:31 by Maya Okafor" />
        </StackPanel>

        <!--  Floating ink toolbar  -->
        <Border
            Margin="40,0,0,32"
            Padding="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            CornerRadius="{StaticResource GlassCornerRadius}"
            Style="{StaticResource GlassPanelStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <InkToolbar
                    x:Name="ScopeToolbar"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="InspectionInkToolbar"
                    AutomationProperties.Name="Annotation tools"
                    Background="Transparent"
                    InitialControls="None"
                    TargetInkCanvas="{x:Bind ScopeInk}">
                    <InkToolbarBallpointPenButton
                        x:Name="PenButton"
                        AutomationProperties.AutomationId="InkPenButton"
                        SelectedStrokeWidth="4" />
                    <InkToolbarHighlighterButton x:Name="HighlighterButton" AutomationProperties.AutomationId="InkHighlighterButton" />
                    <InkToolbarStencilButton x:Name="RulerButton" AutomationProperties.AutomationId="InkRulerButton" />
                    <InkToolbarEraserButton x:Name="EraserButton" AutomationProperties.AutomationId="InkEraserButton" />
                </InkToolbar>
                <Rectangle
                    Width="1"
                    Margin="4,6"
                    Fill="{ThemeResource GlassStrokeBrush}" />
                <Button
                    x:Name="SaveInkButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SaveInkButton"
                    AutomationProperties.Name="Save annotations"
                    Click="OnSaveInk"
                    ToolTipService.ToolTip="Save annotations">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="RestoreInkButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="RestoreInkButton"
                    AutomationProperties.Name="Restore saved annotations"
                    Click="OnRestoreInk"
                    ToolTipService.ToolTip="Restore saved annotations">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                        <TextBlock Text="Restore" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ClearInkButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ClearInkButton"
                    AutomationProperties.Name="Clear annotations"
                    Click="OnClearInk"
                    ToolTipService.ToolTip="Clear annotations">
                    <FontIcon FontSize="14" Glyph="&#xE894;" />
                </Button>
            </StackPanel>
        </Border>

        <!--  Sign-off panel  -->
        <Border
            x:Name="SignOffPanel"
            Width="380"
            Margin="0,28,40,32"
            Padding="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            CornerRadius="{StaticResource GlassCornerRadius}"
            Style="{StaticResource GlassPanelStyle}">
            <Grid>
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="FINDING · WO 2207-014" />
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Fan blade 14 · leading-edge nick"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="DEPTH" />
                            <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="20" Text="0.4 mm" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="LIMIT" />
                            <TextBlock
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="20"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                Text="0.76 mm" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="AMM" />
                            <TextBlock
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="20"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                Text="72-21-00" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Padding="12,8"
                        Background="{ThemeResource HealthySoftBrush}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource HealthyBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                Foreground="{ThemeResource HealthyBrush}"
                                Style="{StaticResource BodyTextStyle}"
                                Text="Within serviceable limits · blend not required" />
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1" Fill="{ThemeResource GlassStrokeBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture
                            Width="40"
                            Height="40"
                            AutomationProperties.Name="Maya Okafor"
                            DisplayName="Maya Okafor" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="0">
                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Maya Okafor" />
                            <TextBlock
                                Foreground="{ThemeResource TertiaryTextBrush}"
                                Style="{StaticResource BodyTextStyle}"
                                Text="B1 licensed engineer · Lic. EASA-B1-48213" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SIGNATURE" />
                            <HyperlinkButton
                                x:Name="ClearSignatureButton"
                                Padding="4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ClearSignatureButton"
                                Click="OnClearSignature"
                                Content="Clear" />
                        </Grid>
                        <Grid
                            x:Name="SignaturePad"
                            Height="132"
                            Background="{ThemeResource SurfaceBrush}"
                            BorderBrush="{ThemeResource GlassStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Rectangle
                                Height="1"
                                Margin="20,0,20,34"
                                VerticalAlignment="Bottom"
                                Fill="{ThemeResource GlassStrokeBrush}"
                                IsHitTestVisible="False" />
                            <TextBlock
                                x:Name="SignatureHint"
                                Margin="20,0,0,12"
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TertiaryTextBrush}"
                                IsHitTestVisible="False"
                                Style="{StaticResource BodyTextStyle}"
                                Text="Sign here" />
                            <Canvas x:Name="SignatureRender" IsHitTestVisible="False" />
                            <InkCanvas
                                x:Name="SignatureInk"
                                AutomationProperties.AutomationId="SignatureInkCanvas"
                                AutomationProperties.Name="Signature pad" />
                        </Grid>
                    </StackPanel>

                    <Button
                        x:Name="SignButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="SignAndReleaseButton"
                        Click="OnSignAndRelease"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel
                            Padding="0,6"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon FontSize="16" Glyph="&#xE8FB;" />
                            <TextBlock FontWeight="SemiBold" Text="Sign &amp; release to service" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        x:Name="ReleaseNote"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TertiaryTextBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Releases CA 2207 for the 05:52 departure" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  One-shot celebration burst  -->
        <Canvas IsHitTestVisible="False">
            <Ellipse
                x:Name="BurstRing"
                Width="320"
                Height="320"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                Stroke="{ThemeResource HealthyBrush}"
                StrokeThickness="6">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="BurstScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse
                x:Name="BurstRing2"
                Width="320"
                Height="320"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                Stroke="{ThemeResource HealthyBrush}"
                StrokeThickness="2">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="BurstScale2" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!--  Released banner  -->
        <Border
            x:Name="ReleasedBanner"
            Margin="0,0,440,0"
            Padding="28,18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource GlassBrush}"
            BorderBrush="{ThemeResource HealthyBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource GlassCornerRadius}"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.RenderTransform>
                <CompositeTransform x:Name="BannerTransform" />
            </Border.RenderTransform>
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource HealthyBrush}"
                    Style="{StaticResource EyebrowTextStyle}"
                    Text="RELEASED TO SERVICE · 03:12" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="Wheels up at 05:52" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
